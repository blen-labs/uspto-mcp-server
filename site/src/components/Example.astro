---
import { Code } from '@astrojs/starlight/components';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { formatSnippet } from '../lib/format.mjs';

interface Props {
  /** A file name in the repository's examples/ folder. */
  file: string;
}

// examples/ and examples/outputs/ are the single source: test/examples.spec.ts runs each file
// in the sandbox against its fixture and checks the result. The paths start at the working
// directory because the build bundles this component elsewhere.
const { file } = Astro.props;
const repoFile = (...parts: string[]) => resolve(process.cwd(), '..', ...parts);
const code = await formatSnippet(readFileSync(repoFile('examples', file), 'utf8'));
const fixture = JSON.parse(readFileSync(repoFile('examples/outputs', file.replace(/\.js$/, '.json')), 'utf8'));
const json = (value: unknown) => JSON.stringify(value, null, 2);
---

<Code code={code} lang="js" title={file} />
<p>
  The output is <strong>synthetic</strong>: the shape of a real result, with invented values.
</p>
<Code code={json(fixture.expected)} lang="json" title={`${file} output (synthetic)`} />
<p>When nothing matches, the program returns this, and does not throw.</p>
<Code code={json(fixture.noMatch.expected)} lang="json" title={`${file} output with no match (synthetic)`} />
