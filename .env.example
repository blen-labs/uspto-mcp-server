# Documentation only: the server does not load this file (no dotenv). Set these in your
# shell, MCP client config, container, or secret manager. Values are the defaults, except
# where marked "example". The file is shell-sourceable: set -a; . ./.env; set +a
#
# Transport — pick via CLI flag (default: stdio)
#   uspto-mcp-server            # stdio
#   uspto-mcp-server --http     # Streamable HTTP
PORT=8080
# Bind address. With --insecure the default is 127.0.0.1 unless HOST or --host is set.
HOST=0.0.0.0
USPTO_LOG_LEVEL=info                # debug | info | warn | error (logs go to stderr)

# Sandbox
# auto: isolated-vm for single-user use (stdio, --insecure), Deno ONLY for authenticated
# HTTP serving (isolate is refused there; without Deno, execute is unavailable).
USPTO_SANDBOX=auto                  # auto | isolate | deno
# execute() limits are per-call tool arguments, not env vars:
# timeoutMs (default 30000, max 120000) and memoryMb (default 64, max 256).
# Byte budgets per execution (code/result 256 KiB, logs 64 KiB / 1000 lines, SDK-call
# arguments 64 KiB, 16 pending calls) are fixed in src/sandbox/limits.ts.
# Simultaneous executions per server and per authenticated subject (Busy beyond).
USPTO_MAX_CONCURRENT_EXECUTIONS=8
USPTO_MAX_EXECUTIONS_PER_SUBJECT=2

# ─── USPTO API keys ──────────────────────────────────────────────────────────
# Keys are personal ("Do not share it with others": https://data.uspto.gov/apis/getting-started).
# Use your own key for yourself; account mode ignores these and uses each user's own keys.
#
# Open Data Portal (api.uspto.gov, sent as X-API-KEY): patents, PTAB, petitions, office
# actions, bulk datasets. Free. Needs a USPTO.gov account with MFA (required since
# 2026-06-18) and a one-time ID.me link; then Manage API Key at https://data.uspto.gov/myodp.
# See https://data.uspto.gov/support/universal-registration. A key "shouldn't expire if it
# is used at least one time per year". Keys of accounts missing the profile fields required
# since 2026-08-18 were deactivated on 2026-10-08 (403 on every call): complete them under
# "Open Data Portal" in your USPTO.gov settings, then click "Activate API Key".
# Without a key the `odp` source is disabled (SourceUnavailable).
USPTO_API_KEY=
# TSDR trademark status (tsdrapi.uspto.gov, sent as USPTO-API-KEY). A separate key from
# https://account.uspto.gov/api-manager (the ODP key is not accepted). Without it the `tsdr`
# source is disabled.
USPTO_TSDR_API_KEY=

# Upstream base URLs (tests and proxies only; account mode always uses the official hosts).
USPTO_ODP_BASE_URL=https://api.uspto.gov
USPTO_TSDR_BASE_URL=https://tsdrapi.uspto.gov
USPTO_USER_AGENT='uspto-mcp-server/0.1 (+https://github.com/blen-labs/uspto-mcp-server)'
USPTO_UPSTREAM_TIMEOUT_MS=30000
# Retries for network errors and 5xx. A 429 pauses every caller of that key for at least
# 5 s (USPTO asks for that) or the full Retry-After, and the call is retried once only if
# the pause is <= 30 s; otherwise it fails with RateLimited.
USPTO_UPSTREAM_RETRIES=2
# Largest upstream response body kept in memory (8 MiB, gzip expansion bounded too);
# bigger fails with ResponseTooLarge.
USPTO_MAX_RESPONSE_BYTES=8388608

# ─── Per-key guardrails (USPTO_ODP_* / USPTO_TSDR_*) ─────────────────────────
# USPTO: one request in flight per key (burst 1), 4-15 requests/s, 5M metadata + 1.2M
# document calls per week per key (reset Sunday 00:00 UTC). See
# https://data.uspto.gov/apis/api-rate-limits. All limits are in-memory, per process.
#
# Upstream calls one execute() may make. 0 means "no calls"; to disable a source, unset its key.
USPTO_ODP_MAX_CALLS_PER_EXECUTE=50
USPTO_TSDR_MAX_CALLS_PER_EXECUTE=25
# Hourly cap per configured key, counting every real upstream attempt (retries included)
# after the cache and the queue. Must be >= 1; 0 is NOT "unlimited". In account mode this is
# the per-account hourly limit, kept in PostgreSQL.
USPTO_ODP_RATE_PER_HOUR=5000
USPTO_TSDR_RATE_PER_HOUR=3000
# Per authenticated subject, per hour (HTTP only; skipped on stdio; one shared `anonymous`
# bucket under --insecure; ignored in account mode). Must be >= 1.
USPTO_ODP_SUBJECT_RATE_PER_HOUR=1000
USPTO_TSDR_SUBJECT_RATE_PER_HOUR=600
# Requests in flight per key. USPTO blocks concurrent requests with one key: keep 1.
USPTO_ODP_CONCURRENCY=1
USPTO_TSDR_CONCURRENCY=1
# Requests started per second per key.
USPTO_ODP_RATE_PER_SEC=4
USPTO_TSDR_RATE_PER_SEC=1
# Longest a call waits in the key's queue before failing with RateLimited.
USPTO_ODP_MAX_WAIT_MS=30000
USPTO_TSDR_MAX_WAIT_MS=30000

# Cache (per source client; also bounded at 32 MiB of response text per client)
USPTO_CACHE_TTL_MS=600000
USPTO_CACHE_MAX_ITEMS=1000

# ─── HTTP transport ─────────────────────────────────────────────────────────
# --http refuses to start without real authentication (an OIDC provider or accounts)
# unless --insecure is given. Request bodies are capped at 1 MiB.
#
# Example: the public origin clients reach (OAuth resource metadata, WWW-Authenticate,
# and a trusted Host). Listening on a non-loopback address requires this or
# USPTO_ALLOWED_HOSTS; Host is never taken from the request.
USPTO_PUBLIC_ORIGIN=https://your-host.example.com
# Extra accepted Host header values, comma-separated (DNS-rebinding protection). The
# public origin's host and loopback on the listening port are always accepted.
# '*' disables the check: only behind a proxy that validates Host itself.
USPTO_ALLOWED_HOSTS=
# Extra browser Origins allowed on /mcp (comma-separated exact origins). The
# server's own origin and loopback are always allowed; requests without an
# Origin header (non-browser MCP clients) always pass; anything else is 403.
USPTO_ALLOWED_ORIGINS=

# Rate limiting (per IP token bucket). RPS must be > 0 and BURST >= 1.
USPTO_IP_RPS=5
USPTO_IP_BURST=20
# Header your reverse proxy overwrites with the client address; Railway: x-real-ip.
# Unset, the limit keys on the TCP peer, which behind a proxy is the proxy itself, so
# clients are not limited individually. Only name a header the proxy always overwrites,
# or clients can forge it. (On Railway, X-Forwarded-For is "<client>, <edge>": not usable.)
# Also keys account mode's per-IP and OAuth limits; set it there too.
USPTO_CLIENT_IP_HEADER=
# Per authenticated subject, requests per UTC day
USPTO_SUBJECT_DAILY_QUOTA=10000

# ─── Auth ────────────────────────────────────────────────────────────────────
# accounts  - Google sign-in, personal encrypted USPTO keys, OAuth/PKCE (see docs/accounts.md)
# none      - no auth: HTTP only together with --insecure
# generic-oidc / clerk / workos / auth0 - JWT bearer verification via jose. ISSUER, AUDIENCE
#             and JWKS_URL are required; the JWKS URL must be https (http only on loopback);
#             tokens need exp and sub and an asymmetric algorithm.
# Any other value stops startup.
USPTO_AUTH_PROVIDER=none
USPTO_AUTH_ISSUER=
USPTO_AUTH_AUDIENCE=
USPTO_AUTH_JWKS_URL=
# Comma-separated scopes every token must carry (403 insufficient_scope otherwise);
# also advertised as scopes_supported in resource metadata.
USPTO_AUTH_SCOPES=

# Required only with USPTO_AUTH_PROVIDER=accounts. Use a dedicated PostgreSQL database.
DATABASE_URL=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# JSON map of key IDs to 32-byte base64 encryption keys. Keep old keys during rotation.
ENCRYPTION_KEYS_JSON=
ENCRYPTION_ACTIVE_KEY_ID=v1
# Account mode serves /mcp (no sign-in: search_api and describe_schema only) and
# /mcp/account (OAuth: all tools, with the user's own ODP/TSDR keys at the official USPTO
# hosts). USPTO_API_KEY / USPTO_TSDR_API_KEY are ignored in account mode. Requires Deno.
