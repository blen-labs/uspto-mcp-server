{
  "name": "@blen/uspto-mcp-server",
  "version": "0.1.1",
  "description": "Code-mode MCP server for the USPTO Open Data Portal (patents, PTAB, petitions, office actions, bulk datasets) and TSDR trademark status APIs.",
  "license": "Apache-2.0",
  "author": "BLEN, Inc. (https://blenlabs.com)",
  "homepage": "https://github.com/blen-labs/uspto-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blen-labs/uspto-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/blen-labs/uspto-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "uspto",
    "patents",
    "trademarks",
    "ptab",
    "patent-file-wrapper",
    "office-actions",
    "tsdr",
    "open-data-portal",
    "code-mode",
    "sandbox",
    "isolated-vm",
    "ai-agents",
    "claude",
    "anthropic",
    "government-data"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "uspto-mcp-server": "dist/bin.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": "^24.11.0 || ^26.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm build:web && (chmod +x dist/bin.js || true)",
    "dev": "tsx src/bin.ts",
    "start": "node dist/bin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "prepack": "pnpm run build",
    "mcpb:prepare": "node scripts/mcpb-prepare.mjs",
    "mcpb:pack": "mcpb pack mcpb-build uspto-mcp-server.mcpb",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite build --watch --config web/vite.config.ts",
    "test:live": "vitest run test/live.spec.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.22",
    "@better-auth/mcp": "1.7.22",
    "@better-auth/oauth-provider": "1.7.22",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "better-auth": "1.7.22",
    "express": "5.3.0",
    "jose": "^6.2.17",
    "lru-cache": "^11.5.3",
    "pg": "8.23.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "isolated-vm": "^7.0.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/express": "5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eslint": "^10.14.0",
    "fetch-cookie": "3.2.0",
    "lucide-react": "1.48.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tough-cookie": "6.0.2",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
